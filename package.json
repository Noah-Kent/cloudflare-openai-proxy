{
  "name": "cloudflare-openai-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:sdk": "node --test tests/sdk/*.test.js",
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "scan:secrets": "python3 scripts/scan-secrets.py",
    "test:long": "node --test tests/stream.long.js"
  },
  "devDependencies": {
    "miniflare": "5.20261103.0-beta",
    "openai": "7.50.0",
    "wrangler": "4.157.0"
  }
}
